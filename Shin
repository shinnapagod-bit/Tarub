--==================================================
-- TOGGLE ANIMATION
--==================================================

local function updateToggle(toggle, circle, icon, enabled, color)
	local targetToggleColor
	local targetCirclePosition

	if enabled then
		targetToggleColor = color
		targetCirclePosition = UDim2.fromOffset(25, 3)
	else
		targetToggleColor = Color3.fromRGB(45, 49, 62)
		targetCirclePosition = UDim2.fromOffset(3, 3)
	end

	TweenService:Create(
		toggle,
		TWEEN_INFO,
		{BackgroundColor3 = targetToggleColor}
	):Play()

	TweenService:Create(
		circle,
		TWEEN_INFO,
		{Position = targetCirclePosition}
	):Play()

	TweenService:Create(
		icon,
		TWEEN_INFO,
		{
			BackgroundColor3 = enabled
				and Color3.fromRGB(35, 60, 55)
				or Color3.fromRGB(38, 43, 57)
		}
	):Play()
end

--==================================================
-- COLLISION
--==================================================

local function setCollision(character, state)
	if not character then
		return
	end

	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			object.CanCollide = state
		end
	end
end

--==================================================
-- STATUS UPDATE
--==================================================

local function updateStatus()
	if noclipEnabled and infiniteJumpEnabled then
		statusText.Text = "BOTH SYSTEMS ACTIVE"
	elseif noclipEnabled then
		statusText.Text = "NOCLIP ACTIVE"
	elseif infiniteJumpEnabled then
		statusText.Text = "INFINITE JUMP ACTIVE"
	else
		statusText.Text = "SYSTEM READY"
	end
end

--==================================================
-- NOCLIP
--==================================================

local function toggleNoclip()
	noclipEnabled = not noclipEnabled

	updateToggle(
		noclipToggle,
		noclipCircle,
		noclipIcon,
		noclipEnabled,
		GREEN
	)

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	local character = player.Character

	if noclipEnabled then

		if character then
			setCollision(character, false)
		end

		noclipConnection = RunService.Heartbeat:Connect(function()
			local currentCharacter = player.Character

			if currentCharacter then
				setCollision(currentCharacter, false)
			end
		end)

	else

		if character then
			setCollision(character, true)
		end

	end

	updateStatus()
end

--==================================================
-- INFINITE JUMP
--==================================================

local function toggleInfiniteJump()
	infiniteJumpEnabled = not infiniteJumpEnabled

	updateToggle(
		jumpToggle,
		jumpCircle,
		jumpIcon,
		infiniteJumpEnabled,
		BLUE
	)

	updateStatus()
end

